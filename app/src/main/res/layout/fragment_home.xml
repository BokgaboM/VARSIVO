<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_logo"
            android:gravity="center"
            android:padding="18dp"
            android:textColor="@color/varsivo_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_peach"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/next_deadline"
            android:textColor="@color/varsivo_text"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardExplorer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_light"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="120dp"
                android:padding="16dp"
                android:text="@string/card_explorer"
                android:textColor="@color/varsivo_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/cardBursaries"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_light"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="120dp"
                android:padding="16dp"
                android:text="@string/card_bursaries"
                android:textColor="@color/varsivo_text"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardTracker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_light"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="120dp"
                android:padding="16dp"
                android:text="@string/card_tracker"
                android:textColor="@color/varsivo_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/cardUniAssist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_peach"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="120dp"
                android:padding="16dp"
                android:text="@string/card_uniassist"
                android:textColor="@color/varsivo_text"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUniAssistNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_grey"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/uniassist_note"
            android:textColor="@color/varsivo_text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>